<% if (plugins.pagespeed) { %>
<div class="stdin"><%- meta.$ %>pagespeed www.alextula.com</div>
<div class="stdout">
<% if (plugins.pagespeed.error) { %>
<span class="error"><%= plugins.pagespeed.error.message %></span>
<% } else { %>
<div class="gauge-row">
<% for (const {score, title} of plugins.pagespeed.scores) { %>
  <div class="gauge-item">
    <svg viewBox="0 0 120 120" width="84" height="84" class="gauge <%= !Number.isNaN(score) ? (score >= 0.9 ? 'high' : score >= 0.5 ? 'average' : 'low') : '' %>">
      <circle class="gauge-base" r="53" cx="60" cy="60"/>
      <% if (!Number.isNaN(score)) { %>
      <circle class="gauge-arc" transform="rotate(-90 60 60)" r="53" cx="60" cy="60" stroke-dasharray="<%= score * 329 %> 329"/>
      <text x="60" y="60" dominant-baseline="central"><%= Math.round(score*100) %></text>
      <% } else { %>
      <text x="60" y="60" dominant-baseline="central">-</text>
      <% } %>
    </svg>
    <span class="gauge-label"><%= title %></span>
  </div>
<% } %>
</div>
<% if (plugins.pagespeed.scores && plugins.pagespeed.scores.length) { %>
<span class="diff">&#9656; Overall score</span>
  <span class="ps1-path"><%= Math.round((plugins.pagespeed.scores.reduce((a,{score}) => a+score, 0) / plugins.pagespeed.scores.length) * 100) %>%</span>
<% } %>
<% } %>
</div>
<% } %>